---
import BaseLayout from '../layouts/BaseLayout.astro';
import ActionIcon from './ActionIcon.astro';
import ProcessIcon from './ProcessIcon.astro';
import type { Locale } from '../content/site';
import { copy } from '../content/site';
import { pagesCopy, pagePath } from '../content/pages';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = pagesCopy[locale];
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const skills = copy[locale].technologyGroups.flatMap((group) => group.items);
const processSteps = [
  { icon: 'discovery', label: t.steps[0] },
  { icon: 'planning', label: t.steps[1] },
  { icon: 'development', label: t.steps[2] },
  { icon: 'handover', label: t.steps[3] },
] as const;
---
<BaseLayout locale={locale} page="about">
  <div class="container about-wrap">
    <section class="about-hero" aria-labelledby="about-title">
      <div class="about-art" aria-hidden="true"><div class="about-art-frame"><div class="about-art-top"><span></span><span></span><span></span></div><div class="about-art-columns"><div class="about-art-rail"><i></i><i></i><i></i><i></i></div><div class="about-art-main"><div class="about-art-block"></div><div class="about-art-lines"><i></i><i></i><i></i></div><div class="about-art-panels"><i></i><i></i></div></div></div></div><p>{locale === 'en' ? 'WEB / SOFTWARE / SYSTEMS' : 'เว็บไซต์ / ซอฟต์แวร์ / ระบบ'}</p></div>
      <div class="about-hero-copy"><p class="eyebrow">{t.heroTag}</p><h1 id="about-title">{t.aboutLead}<br /><span>{t.aboutFocus}</span></h1><p>{t.aboutBody1}</p><p>{t.aboutBody2}</p><p class="small-note">{t.aboutNote}</p><a class="text-link" href={pagePath(base, locale, 'contact')}>{t.heroContact} <ActionIcon name="arrow-right" /></a></div>
    </section>
    <section class="skills-section" aria-labelledby="skills-title"><div class="center-heading"><h2 id="skills-title">{t.skillsTitle}</h2><p>{t.skillsIntro}</p></div><ul class="skill-list">{skills.map((skill) => <li>{skill}</li>)}</ul></section>
    <section class="process-section" aria-labelledby="process-title"><div class="center-heading"><h2 id="process-title">{t.processTitle}</h2><p>{t.processIntro}</p></div><ol class="process-grid">{processSteps.map((step, index) => <li><div class="process-marker"><ProcessIcon name={step.icon} /><span aria-hidden="true">0{index + 1}</span></div><h3>{step.label}</h3></li>)}</ol></section>
  </div>
</BaseLayout>
