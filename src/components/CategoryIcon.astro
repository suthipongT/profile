---
import type { ProjectCategory } from '../content/projects';
interface Props { category: ProjectCategory }
const { category } = Astro.props;
---
<svg class="category-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {category === 'corporate-website' && <><rect x="3" y="4" width="18" height="16" rx="2" /><path d="M3 9h18M7 6.5h.01M10 6.5h.01" /></>}
  {category === 'crm' && <><circle cx="9" cy="8" r="3" /><path d="M3 20v-2a6 6 0 0 1 12 0v2M16 5.5a3 3 0 0 1 0 5.8M18 14a5 5 0 0 1 3 4.6V20" /></>}
  {category === 'cms' && <><rect x="4" y="3" width="16" height="18" rx="2" /><path d="M8 8h8M8 12h8M8 16h5" /></>}
  {category === 'erp-business-management' && <><rect x="3" y="4" width="18" height="16" rx="2" /><path d="M8 16v-4M12 16V8M16 16v-6" /></>}
</svg>
