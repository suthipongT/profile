---
import BaseLayout from '../layouts/BaseLayout.astro';
import { copy, type Locale } from '../content/site';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = copy[locale];
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const currentPath = locale === 'en' ? base : `${base}th/`;
---
<BaseLayout locale={locale}>
  <section class="hero section-pad" aria-labelledby="hero-title">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow"><span class="eyebrow-line"></span>{t.eyebrow}</p>
        <h1 id="hero-title">{t.heroTitle}</h1>
        <p class="hero-description">{t.heroDescription}</p>
        <div class="hero-actions">
          <a class="button button-primary" href={`${currentPath}#projects`}>{t.primaryAction}<span aria-hidden="true">↗</span></a>
          <a class="button button-ghost" href={`${currentPath}#contact`}>{t.secondaryAction}<span aria-hidden="true">→</span></a>
        </div>
        <p class="hero-availability"><span class="availability-dot" aria-hidden="true"></span>{t.availability}</p>
      </div>
      <div class="hero-art" aria-hidden="true">
        <div class="art-orbit art-orbit-one"></div><div class="art-orbit art-orbit-two"></div>
        <div class="terminal-card">
          <div class="terminal-top"><span class="window-dots"><i></i><i></i><i></i></span><span>portfolio.ts</span><span>●</span></div>
          <div class="terminal-content">
            <p><span class="line-number">01</span><span class="code-purple">const</span> <span class="code-cyan">developer</span> = {'{'}</p>
            <p><span class="line-number">02</span>  name: <span class="code-yellow">'Suthipong'</span>,</p>
            <p><span class="line-number">03</span>  focus: <span class="code-yellow">'the web'</span>,</p>
            <p><span class="line-number">04</span>  approach: [</p>
            <p><span class="line-number">05</span>    <span class="code-yellow">'clarity'</span>,</p>
            <p><span class="line-number">06</span>    <span class="code-yellow">'craft'</span>,</p>
            <p><span class="line-number">07</span>    <span class="code-yellow">'care'</span></p>
            <p><span class="line-number">08</span>  ]</p>
            <p><span class="line-number">09</span>{'}'};</p>
          </div>
          <div class="terminal-footer"><span>ASTRO / TYPESCRIPT</span><span class="terminal-cursor">▍</span></div>
        </div>
        <div class="art-tag art-tag-top">&lt;build /&gt;</div>
        <div class="art-tag art-tag-bottom">01 — 06</div>
      </div>
    </div>
    <div class="container"><p class="draft-banner"><span aria-hidden="true">✳</span>{t.heroNote}</p></div>
  </section>

  <section id="about" class="section section-about" aria-labelledby="about-title">
    <div class="container section-grid">
      <div><p class="section-kicker">{t.aboutKicker}</p><h2 id="about-title">{t.aboutTitle}</h2></div>
      <div class="section-main"><p class="large-body">{t.aboutBody}</p><div class="about-note"><span class="note-icon" aria-hidden="true">↗</span><p>{t.aboutAside}</p></div></div>
    </div>
  </section>

  <section id="expertise" class="section section-shaded" aria-labelledby="expertise-title">
    <div class="container">
      <div class="section-head"><div><p class="section-kicker">{t.expertiseKicker}</p><h2 id="expertise-title">{t.expertiseTitle}</h2></div><p>{t.expertiseIntro}</p></div>
      <div class="expertise-grid">
        {t.expertise.map((item) => <article class="expertise-card"><span class="card-number">{item.number} / 03</span><div class="card-symbol" aria-hidden="true">↗</div><h3>{item.title}</h3><p>{item.description}</p><span class="card-detail">{item.detail}</span></article>)}
      </div>
    </div>
  </section>

  <section id="stack" class="section" aria-labelledby="stack-title">
    <div class="container stack-grid">
      <div><p class="section-kicker">{t.stackKicker}</p><h2 id="stack-title">{t.stackTitle}</h2><p class="section-description">{t.stackBody}</p></div>
      <div class="stack-panel">
        {t.stackGroups.map((group) => <div class="stack-group"><h3>{group.label}</h3><ul>{group.items.map((item) => <li>{item}</li>)}</ul></div>)}
      </div>
    </div>
  </section>

  <section id="projects" class="section section-shaded" aria-labelledby="projects-title">
    <div class="container">
      <div class="section-head"><div><p class="section-kicker">{t.projectsKicker}</p><h2 id="projects-title">{t.projectsTitle}</h2></div><p>{t.projectsIntro}</p></div>
      <div class="project-grid">
        {t.projectCards.map((item, index) => <article class="project-card"><div class={`project-visual visual-${index + 1}`} aria-hidden="true"><span>{index === 0 ? '< />' : index === 1 ? '{ }' : '↗'}</span><div class="visual-grid"></div></div><div class="project-content"><span class="project-number">{item.number}</span><h3>{item.title}</h3><p>{item.description}</p><div class="project-detail">{item.detail}</div></div></article>)}
      </div>
    </div>
  </section>

  <section id="experience" class="section" aria-labelledby="experience-title">
    <div class="container section-grid">
      <div><p class="section-kicker">{t.experienceKicker}</p><h2 id="experience-title">{t.experienceTitle}</h2></div>
      <div class="section-main"><p class="large-body">{t.experienceBody}</p><div class="experience-draft"><span class="draft-label">{locale === 'en' ? 'VERIFICATION CHECKLIST' : 'ข้อมูลที่ต้องตรวจสอบ'}</span><ul>{t.experienceItems.map((item) => <li><span aria-hidden="true">○</span>{item}</li>)}</ul></div></div>
    </div>
  </section>

  <section id="contact" class="section contact-section" aria-labelledby="contact-title">
    <div class="container contact-inner"><p class="section-kicker">{t.contactKicker}</p><h2 id="contact-title">{t.contactTitle}</h2><p>{t.contactBody}</p><a class="button button-primary" href="https://github.com/suthipongT">{t.contactAction}<span aria-hidden="true">↗</span></a><div class="contact-decoration" aria-hidden="true">&lt;/&gt;</div></div>
  </section>
</BaseLayout>
