---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectShowcase from './ProjectShowcase.astro';
import { copy, type Locale } from '../content/site';
import { approvedProjects } from '../content/projects';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = copy[locale];
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const currentPath = locale === 'en' ? base : `${base}th/`;
const selectedProjects = [...approvedProjects].sort((a, b) => Number(b.featured) - Number(a.featured));
const categories = ['corporate-website', 'crm', 'cms', 'erp-business-management'] as const;
---
<BaseLayout locale={locale}>
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero-grid">
      <div class="hero-main">
        <p class="eyebrow">{t.heroEyebrow}</p>
        <h1 id="hero-title">{t.heroTitle}</h1>
        <p class="hero-description">{t.heroDescription}</p>
        <div class="hero-actions">
          <a class="button button-primary" href={`${currentPath}#work`}>{t.primaryAction}<span aria-hidden="true">↗</span></a>
          <a class="button button-secondary" href={`${currentPath}#contact`}>{t.secondaryAction}<span aria-hidden="true">→</span></a>
        </div>
      </div>
      <aside class="hero-capabilities" aria-label={t.heroCapabilitiesLabel}>
        <p class="small-label">{t.heroCapabilitiesLabel}</p>
        <ol>{categories.map((category, index) => <li><span aria-hidden="true">0{index + 1}</span>{t.categoryLabels[category]}</li>)}</ol>
      </aside>
    </div>
  </section>

  <section id="work" class="section section-work" aria-labelledby="work-title">
    <div class="container">
      <div class="section-heading">
        <div><p class="eyebrow">{t.workKicker}</p><h2 id="work-title">{t.workTitle}</h2></div>
        <p>{t.workIntro}</p>
      </div>
      {selectedProjects.length > 0
        ? <div class="project-list">{selectedProjects.map((project, index) => <ProjectShowcase project={project} locale={locale} priority={index === 0} />)}</div>
        : <div class="work-empty"><span class="work-empty-line" aria-hidden="true"></span><div><h3>{t.workEmptyTitle}</h3><p>{t.workEmptyBody}</p></div></div>}
    </div>
  </section>

  <section id="services" class="section" aria-labelledby="services-title">
    <div class="container">
      <div class="section-heading">
        <div><p class="eyebrow">{t.servicesKicker}</p><h2 id="services-title">{t.servicesTitle}</h2></div>
        <p>{t.servicesIntro}</p>
      </div>
      <div class="service-grid">
        {t.services.map((service, index) => <article class="service-item"><span class="item-number">0{index + 1}</span><div><h3>{t.categoryLabels[service.category]}</h3><p>{service.description}</p></div></article>)}
      </div>
    </div>
  </section>

  <section id="technology" class="section section-muted" aria-labelledby="technology-title">
    <div class="container split-section">
      <div><p class="eyebrow">{t.technologyKicker}</p><h2 id="technology-title">{t.technologyTitle}</h2><p class="section-intro">{t.technologyIntro}</p></div>
      <div class="technology-groups">
        {t.technologyGroups.map((group) => <div class="technology-group"><h3>{group.title}</h3><ul>{group.items.map((item) => <li>{item}</li>)}</ul></div>)}
      </div>
    </div>
  </section>

  <section id="process" class="section" aria-labelledby="process-title">
    <div class="container">
      <div class="section-heading">
        <div><p class="eyebrow">{t.processKicker}</p><h2 id="process-title">{t.processTitle}</h2></div>
        <p>{t.processIntro}</p>
      </div>
      <ol class="process-list">{t.processSteps.map((step, index) => <li><span class="item-number">0{index + 1}</span><h3>{step.title}</h3><p>{step.description}</p></li>)}</ol>
    </div>
  </section>

  <section id="about" class="section section-muted" aria-labelledby="about-title">
    <div class="container split-section">
      <div><p class="eyebrow">{t.aboutKicker}</p><h2 id="about-title">{t.aboutTitle}</h2></div>
      <div class="about-copy"><p>{t.aboutBody}</p><p class="about-note">{t.aboutNote}</p></div>
    </div>
  </section>

  <section id="contact" class="section contact-section" aria-labelledby="contact-title">
    <div class="container contact-inner">
      <p class="eyebrow">{t.contactKicker}</p>
      <h2 id="contact-title">{t.contactTitle}</h2>
      <p>{t.contactBody}</p>
      <a class="button button-primary" href="https://github.com/suthipongT">{t.contactAction}<span aria-hidden="true">↗</span></a>
    </div>
  </section>
</BaseLayout>
