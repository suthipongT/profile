---
import { copy, type Locale } from '../content/site';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = copy[locale];
---
<div class="hero-visual" aria-hidden="true">
  <div class="visual-site">
    <div class="visual-topbar"><span class="visual-dots"><i></i><i></i><i></i></span><span>{t.heroVisualWebsiteLabel}</span></div>
    <div class="visual-site-nav"><span class="visual-site-mark"></span><span class="visual-site-navline"></span><span class="visual-site-navline short"></span></div>
    <div class="visual-site-body">
      <span class="visual-site-kicker">{t.heroVisualWebsiteLabel}</span>
      <strong>{t.heroVisualWebsiteTitle}</strong>
      <span class="visual-site-rule"></span>
      <span class="visual-site-action">{t.heroVisualWebsiteAction} <span>↗</span></span>
    </div>
    <div class="visual-site-art"><span></span><span></span><span></span></div>
  </div>
  <div class="visual-system">
    <div class="visual-system-head"><span class="visual-system-icon">▦</span><span>{t.heroVisualSystemLabel}</span><span class="visual-system-dot"></span></div>
    <div class="visual-system-body">
      <p>{t.heroVisualSystemTitle}</p>
      <div class="visual-system-track"><span></span><span></span><span></span></div>
      <ol>{t.heroVisualSteps.map((step, index) => <li><span>0{index + 1}</span><strong>{step}</strong><i></i></li>)}</ol>
    </div>
  </div>
  <span class="visual-edge-label">{t.heroVisualEdgeLabel}</span>
</div>
