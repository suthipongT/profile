---
import BaseLayout from '../layouts/BaseLayout.astro';
import ActionIcon from './ActionIcon.astro';
import ProjectTile from './ProjectTile.astro';
import type { Locale } from '../content/site';
import { pagesCopy, pagePath } from '../content/pages';
import { approvedProjects, featuredProjects, validateProjectSlugs, type ShowcaseProject } from '../content/projects';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = pagesCopy[locale];
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const preview = import.meta.env.PUBLIC_PORTFOLIO_PREVIEW === 'true';
const projects: readonly ShowcaseProject[] = preview ? (await import('../content/demo-projects')).demoProjects : approvedProjects;
validateProjectSlugs(projects);
const featured = featuredProjects(projects);
---
<BaseLayout locale={locale} page="home">
  <section class="home-hero" aria-labelledby="home-title">
    <div class="container hero-center">
      <h1 id="home-title">{t.heroLead}<br /><span>{t.heroFocus}</span></h1>
      <p class="hero-intro">{t.heroBody}</p>
      <div class="hero-buttons">
        <a class="button button-dark" href={pagePath(base, locale, 'portfolio')}>{t.heroWork} <ActionIcon name="arrow-right" /></a>
        <a class="button button-outline" href={pagePath(base, locale, 'contact')}>{t.heroContact}</a>
      </div>
      <p class="hero-services" aria-label={t.servicesTitle}>{locale === 'en' ? 'CORPORATE WEBSITES  /  CRM  /  CMS  /  ERP' : 'เว็บไซต์องค์กร  /  CRM  /  CMS  /  ERP'}</p>
    </div>
  </section>
  <section class="featured-section" aria-labelledby="featured-title">
    <div class="container">
      <div class="center-heading"><h2 id="featured-title">{t.featuredTitle}</h2><p>{preview ? t.featuredPreview : t.featuredProduction}</p></div>
      {featured.length > 0 ? <div class="featured-grid">{featured.map((project) => <ProjectTile project={project} locale={locale} demo={preview} compact />)}</div> : <div class="empty-state"><h3>{t.emptyTitle}</h3><p>{t.emptyBody}</p></div>}
      <div class="center-action"><a class="button button-outline" href={pagePath(base, locale, 'portfolio')}>{t.viewAll} <ActionIcon name="arrow-right" /></a></div>
    </div>
  </section>
</BaseLayout>
