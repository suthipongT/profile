---
import { Image } from 'astro:assets';
import type { Locale } from '../content/site';
import type { ShowcaseProject } from '../content/projects';
import { copy } from '../content/site';

interface Props { project: ShowcaseProject; locale: Locale; priority?: boolean; demo?: boolean }
const { project, locale, priority = false, demo = false } = Astro.props;
const t = copy[locale];
const content = project.content[locale];
const [lead, ...supporting] = project.screenshots ?? [];
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const imageSrc = (src: string) => src.startsWith(base) ? src : `${base}${src.replace(/^\//, '')}`;
---
<article class:list={['project-showcase', { 'project-showcase-text': !lead }]} data-demo-project={demo ? project.id : undefined}>
  {lead && <div class="project-media">
    <figure>
      {lead.image.format === 'svg'
        ? <img src={imageSrc(lead.image.src)} alt={lead.alt[locale]} width={lead.image.width} height={lead.image.height} loading={priority ? 'eager' : 'lazy'} decoding="async" />
        : <Image src={lead.image} alt={lead.alt[locale]} layout="constrained" widths={[480, 768, 1200, 1600]} sizes="(min-width: 1000px) 60vw, 100vw" loading={priority ? 'eager' : 'lazy'} decoding="async" />}
      <figcaption>{lead.caption && <span>{lead.caption[locale]}</span>}<a href={imageSrc(lead.image.src)} target="_blank" rel="noopener">{t.projectImageLabel} <span aria-hidden="true">↗</span></a></figcaption>
    </figure>
    {supporting.length > 0 && <div class="project-supporting">
      {supporting.map((shot) => <figure>
        {shot.image.format === 'svg'
          ? <img src={imageSrc(shot.image.src)} alt={shot.alt[locale]} width={shot.image.width} height={shot.image.height} loading="lazy" decoding="async" />
          : <Image src={shot.image} alt={shot.alt[locale]} layout="constrained" widths={[360, 640, 960]} sizes="(min-width: 1000px) 30vw, 100vw" loading="lazy" decoding="async" />}
        <figcaption>{shot.caption && <span>{shot.caption[locale]}</span>}<a href={imageSrc(shot.image.src)} target="_blank" rel="noopener">{t.projectImageLabel} <span aria-hidden="true">↗</span></a></figcaption>
      </figure>)}
    </div>}
  </div>}
  <div class="project-copy">
    {demo && <p class="demo-project-label">{t.demoProjectLabel}</p>}
    <p class="project-category">{t.categoryLabels[project.category]}</p>
    <h3>{content.name}</h3>
    <p class="project-summary">{content.summary}</p>
    <p class="project-description">{content.description}</p>
    <dl class="project-facts">
      <div><dt>{demo ? t.demoRoleLabel : t.projectRoleLabel}</dt><dd>{content.role}</dd></div>
      <div><dt>{demo ? t.demoScopeLabel : t.projectScopeLabel}</dt><dd>{content.scope}</dd></div>
      <div><dt>{demo ? t.demoTechnologyLabel : t.projectTechnologyLabel}</dt><dd>{project.technologies.join(' · ')}</dd></div>
    </dl>
    {(project.liveUrl || project.repositoryUrl) && <div class="project-links">
      {project.liveUrl && <a href={project.liveUrl}>{t.projectLiveLabel} <span aria-hidden="true">↗</span></a>}
      {project.repositoryUrl && <a href={project.repositoryUrl}>{t.projectRepositoryLabel} <span aria-hidden="true">↗</span></a>}
    </div>}
  </div>
</article>
