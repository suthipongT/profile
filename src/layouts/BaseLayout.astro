---
import '../styles/global.css';
import type { Locale } from '../content/site';
import { pagePath, pagesCopy, type Page } from '../content/pages';

interface Props { locale: Locale; page: Page }
const { locale, page } = Astro.props;
const t = pagesCopy[locale];
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const preview = import.meta.env.PUBLIC_PORTFOLIO_PREVIEW === 'true';
const site = Astro.site ?? new URL('https://suthipongt.github.io');
const currentPath = pagePath(base, locale, page);
const canonical = new URL(currentPath, site).href;
const pageTitle = t.meta[page][0];
const pageDescription = t.meta[page][1];
const navPages: Page[] = ['home', 'portfolio', 'about', 'contact'];
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#FFFFFF" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="robots" content={preview ? 'noindex, nofollow, noarchive' : 'index, follow'} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={new URL(pagePath(base, 'en', page), site).href} />
    <link rel="alternate" hreflang="th" href={new URL(pagePath(base, 'th', page), site).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(pagePath(base, 'th', page), site).href} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Suthipong Toonritsa" />
    <meta property="og:locale" content={locale === 'en' ? 'en_US' : 'th_TH'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(`${base}og-card.svg`, site).href} />
    <meta property="og:image:alt" content={locale === 'en' ? 'Suthipong Toonritsa software development portfolio graphic' : 'ภาพกราฟิกพอร์ตโฟลิโอพัฒนาซอฟต์แวร์ของ Suthipong Toonritsa'} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class:list={[`page-${page}`, { 'is-preview': preview }]}>
    <a class="skip-link" href="#main">{t.skip}</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href={pagePath(base, locale, 'home')} aria-label={locale === 'en' ? 'Suthipong, home' : 'Suthipong, หน้าแรก'}>Suthipong<span aria-hidden="true">.</span></a>
        <nav class="desktop-nav" aria-label={locale === 'en' ? 'Primary navigation' : 'เมนูหลัก'}>
          {navPages.map((item) => <a href={pagePath(base, locale, item)} aria-current={item === page ? 'page' : undefined}>{t.nav[item]}</a>)}
        </nav>
        <div class="header-actions">
          <nav class="language-switch" aria-label={locale === 'en' ? 'Language' : 'ภาษา'}>
            <a lang="en" href={pagePath(base, 'en', page)} aria-current={locale === 'en' ? 'page' : undefined}>EN</a><span aria-hidden="true">/</span><a lang="th" href={pagePath(base, 'th', page)} aria-current={locale === 'th' ? 'page' : undefined}>TH</a>
          </nav>
          <details class="mobile-nav">
            <summary aria-label={t.menu}><span></span><span></span><span></span></summary>
            <nav aria-label={locale === 'en' ? 'Mobile navigation' : 'เมนูมือถือ'}>
              {navPages.map((item) => <a href={pagePath(base, locale, item)} aria-current={item === page ? 'page' : undefined}>{t.nav[item]}</a>)}
            </nav>
          </details>
        </div>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="container footer-grid">
        <div><a class="footer-brand" href={pagePath(base, locale, 'home')}>Suthipong<span>.</span></a><p>{t.footerBody}</p></div>
        <nav aria-label={t.footerLinks}><strong>{t.footerLinks}</strong>{navPages.map((item) => <a href={pagePath(base, locale, item)}>{t.nav[item]}</a>)}</nav>
      </div>
      <div class="container footer-bottom"><span>© {new Date().getFullYear()} Suthipong Toonritsa</span><span>{t.footerNote}</span></div>
    </footer>
    <script>
      document.querySelectorAll<HTMLDetailsElement>('.mobile-nav').forEach((menu) => {
        menu.querySelectorAll('nav a').forEach((link) => link.addEventListener('click', () => { menu.open = false; }));
        menu.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && menu.open) { menu.open = false; menu.querySelector('summary')?.focus(); }
        });
        document.addEventListener('click', (event) => { if (menu.open && !menu.contains(event.target as Node)) menu.open = false; });
      });
    </script>
  </body>
</html>
